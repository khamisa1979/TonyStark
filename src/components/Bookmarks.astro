---
// The markup renders during the static build. Browser-only behavior stays in
// the client-side script below so the static build never accesses browser APIs.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import {
    createSlug,
    formatBookmark,
    loadBookmarks,
    normalizeUrl,
    type Bookmark,
  } from '../lib/bookmarks';

  const STORAGE_KEY = 'mona-bookmarks';
  const COUNTER_KEY = 'mona-bookmarks-counter';

  const form = document.getElementById('add-bookmark');
  const urlElement = document.getElementById('url');
  const urlInput = urlElement instanceof HTMLInputElement ? urlElement : null;
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const bookmarkList = document.getElementById('bookmark-list');
  const clearAll = document.getElementById('clear-all');

  function readStorage(key: string): string | null {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function writeStorage(key: string, value: string): void {
    try {
      localStorage.setItem(key, value);
    } catch {
      // Storage can be unavailable or full; the in-memory list still works.
    }
  }

  function removeStorage(key: string): void {
    try {
      localStorage.removeItem(key);
    } catch {
      // Storage can be unavailable, so clearing it is best effort.
    }
  }

  function readCounter(): number {
    const stored = Number.parseInt(readStorage(COUNTER_KEY) ?? '', 10);
    return Number.isSafeInteger(stored) && stored > 0 ? stored : 0;
  }

  let bookmarks: Bookmark[] = loadBookmarks(readStorage(STORAGE_KEY));
  let counter = readCounter();

  function persistBookmarks(): void {
    try {
      writeStorage(STORAGE_KEY, JSON.stringify(bookmarks));
    } catch {
      // JSON serialization of validated bookmarks should not fail.
    }
  }

  function nextSlug(): string {
    let slug: string;
    do {
      counter = counter >= Number.MAX_SAFE_INTEGER ? 0 : counter + 1;
      slug = createSlug(counter);
    } while (bookmarks.some((bookmark) => bookmark.slug === slug));
    writeStorage(COUNTER_KEY, String(counter));
    return slug;
  }

  function render(): void {
    if (!bookmarkList) {
      return;
    }

    bookmarkList.replaceChildren();
    const hasBookmarks = bookmarks.length > 0;
    emptyState?.toggleAttribute('hidden', hasBookmarks);
    listHeader?.toggleAttribute('hidden', !hasBookmarks);

    for (const bookmark of bookmarks) {
      const row = document.createElement('li');
      row.className = 'bookmark';
      row.setAttribute('aria-label', formatBookmark(bookmark));

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.setAttribute('aria-hidden', 'true');
      separator.textContent = ' :: ';

      const slug = document.createElement('code');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copy = document.createElement('button');
      copy.className = 'copy';
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.addEventListener('click', async () => {
        let copied = false;
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(bookmark.slug);
            copied = true;
          } else {
            const temporaryInput = document.createElement('textarea');
            temporaryInput.value = bookmark.slug;
            temporaryInput.setAttribute('readonly', '');
            temporaryInput.style.position = 'fixed';
            temporaryInput.style.opacity = '0';
            document.body.append(temporaryInput);
            temporaryInput.select();
            copied = document.execCommand('copy');
            temporaryInput.remove();
          }
        } catch {
          copied = false;
        }
        copy.textContent = copied ? 'Copied' : 'Copy failed';
        window.setTimeout(() => {
          copy.textContent = 'Copy';
        }, 1200);
      });

      row.append(link, separator, slug, copy);
      bookmarkList.append(row);
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      const normalizedUrl = normalizeUrl(urlInput?.value ?? '');
      if (!normalizedUrl) {
        urlInput?.setCustomValidity('Enter a valid HTTP(S) URL.');
        urlInput?.reportValidity();
        return;
      }

      urlInput?.setCustomValidity('');
      bookmarks = [...bookmarks, { url: normalizedUrl, slug: nextSlug() }];
      persistBookmarks();
      render();
      if (urlInput) {
        urlInput.value = '';
      }
    } catch {
      urlInput?.setCustomValidity('Unable to save this bookmark.');
      urlInput?.reportValidity();
    }
  });

  clearAll?.addEventListener('click', () => {
    if (!bookmarks.length || !window.confirm('Clear all saved bookmarks?')) {
      return;
    }

    bookmarks = [];
    removeStorage(STORAGE_KEY);
    removeStorage(COUNTER_KEY);
    render();
  });

  render();
</script>
