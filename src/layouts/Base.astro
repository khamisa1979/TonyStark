---
const { title = 'AI in Finance | Research, News & Reports' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      /* Monaspace webfonts (GitHub Next, SIL OFL 1.1) self-hosted from /public/fonts.
         Neon carries body text; Xenon gives headings a touch of contrast.
         Self-hosting keeps the app fully offline-capable — no runtime CDN needed;
         the ui-monospace fallback still covers any load failure. */
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-400.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-700.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-700.woff2') format('woff2');
      }
      :root {
        color-scheme: light;
        --accent: #145b52;
        --accent-soft: #e6f2ef;
        --ink: #172b2a;
        --muted: #536765;
        --paper: #f7faf8;
        --border: #d7e2de;
        --radius: 0.8rem;
        --font-body: 'Monaspace Neon', ui-monospace, 'SF Mono', 'Cascadia Code', monospace;
        --font-head: 'Monaspace Xenon', 'Monaspace Neon', ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--font-body);
        line-height: 1.6;
      }
      a { color: var(--accent); }
      a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
      .hero, main, footer { width: min(100% - 2.5rem, 68rem); margin-inline: auto; }
      .hero { padding: 4.5rem 0 3rem; }
      .eyebrow, .card-label {
        margin: 0;
        color: var(--accent);
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }
      h1, h2, h3 { font-family: var(--font-head); line-height: 1.2; }
      h1 { max-width: 13ch; margin: 0.6rem 0 1rem; font-size: clamp(2.6rem, 7vw, 4.8rem); letter-spacing: -0.04em; }
      .tagline { max-width: 48rem; margin: 0; color: var(--muted); font-size: 1.08rem; }
      .quick-links { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 1.8rem; }
      .quick-links a {
        padding: 0.45rem 0.75rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: white;
        font-size: 0.84rem;
        text-decoration: none;
      }
      .quick-links a:hover { border-color: var(--accent); }
      main { padding-bottom: 2rem; }
      section { margin: 0 0 4.5rem; scroll-margin-top: 1.5rem; }
      .section-heading { max-width: 49rem; margin-bottom: 1.35rem; }
      .section-heading h2 { margin: 0.4rem 0; font-size: clamp(1.6rem, 4vw, 2.3rem); letter-spacing: -0.025em; }
      .section-heading > p:last-child { margin: 0; color: var(--muted); }
      .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: 1rem; }
      .resource-card, .report {
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: white;
      }
      .resource-card {
        display: flex;
        min-height: 15rem;
        flex-direction: column;
        align-items: flex-start;
        padding: 1.3rem;
        color: inherit;
        text-decoration: none;
        transition: border-color 150ms ease, transform 150ms ease;
      }
      .resource-card:hover { transform: translateY(-2px); border-color: var(--accent); }
      .card-label { font-size: 0.67rem; letter-spacing: 0.06em; }
      .resource-card h3, .report h3 { margin: 0.7rem 0 0.45rem; font-size: 1.12rem; }
      .resource-card p, .report p { margin: 0; color: var(--muted); font-size: 0.88rem; }
      .card-link { margin-top: auto; padding-top: 1.1rem; color: var(--accent); font-size: 0.82rem; font-weight: 700; }
      .infographic-section { padding: 2rem; border-radius: calc(var(--radius) * 1.5); background: #eaf3f0; }
      .infographic { margin: 0; }
      .use-case-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: 0.75rem; }
      .use-case { min-height: 13.5rem; padding: 1rem; border-radius: var(--radius); background: white; }
      .use-case-number { color: var(--accent); font-size: 0.72rem; font-weight: 700; }
      .use-case h3 { margin: 0.55rem 0; font-size: 1rem; }
      .use-case p { margin: 0; color: var(--muted); font-size: 0.82rem; }
      .outcome { display: block; margin-top: 1rem; padding-top: 0.7rem; border-top: 1px solid var(--border); color: var(--accent); font-size: 0.72rem; font-weight: 700; }
      figcaption { max-width: 58rem; margin-top: 1rem; color: var(--muted); font-size: 0.78rem; }
      .report-list { display: grid; gap: 0.75rem; }
      .report { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem 2rem; padding: 1.25rem; }
      .report > div:first-child { flex: 1 1 34rem; }
      .report h3 { margin-top: 0.45rem; }
      .report-actions { display: flex; flex-wrap: wrap; align-content: center; gap: 0.6rem 1rem; }
      .report-actions a { font-size: 0.82rem; font-weight: 700; white-space: nowrap; }
      footer { padding: 0 0 3rem; color: var(--muted); font-size: 0.78rem; }
      @media (max-width: 38rem) {
        .hero { padding-top: 3rem; }
        .infographic-section { padding: 1.25rem; }
        .report { padding: 1rem; }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
